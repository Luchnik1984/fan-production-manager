# ============================================
# API SERVER SETTINGS
# ============================================
API_PORT=8083

# ============================================
# SETTINGS FOR POSTGRESQL
# ============================================

DB_NAME=fan
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=user
DB_PASSWORD=password

# ============================================
# HIBERNATE SETTINGS
# ============================================
HIBERNATE_DDL=validate
SHOW_SQL=true
FORMAT_SQL=true

# ============================================
# FLYWAY SETTINGS
# ============================================
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=true

# ============================================
# APPLICATION SETTING
# ============================================
LOG_DIR=./logs
LOG_LEVEL=DEBUG
HIBERNATE_SQL_LOG_LEVEL=DEBUG

# ============================================
# AUDIT LOG SETTINGS
# ============================================
AUDIT_RETENTION_DAYS=90
AUDIT_MAX_RECORDS=50000

ADMIN_SECRET_KEY=123456789

# ============================================
# JWT SETTINGS
# ============================================
JWT_SECRET=mySecretKeyForJWTTokenGeneration12345678901234567890
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000
