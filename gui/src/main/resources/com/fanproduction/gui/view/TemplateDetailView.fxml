<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.fanproduction.gui.controller.TemplateDetailController"
      minWidth="750">

    <!-- ========== Состояние "нет шаблона" ========== -->
    <StackPane fx:id="noTemplatePane" visible="false" managed="false"
               style="-fx-background-color: #f5f5f5;" VBox.vgrow="ALWAYS">
        <VBox alignment="CENTER" spacing="15" style="-fx-padding: 40px;">
            <Label text="Для этой серии ещё нет шаблона"
                   style="-fx-font-size: 14px; -fx-text-fill: #888;"/>
            <Button fx:id="createTemplateButton" text="➕ Создать шаблон"
                    onAction="#handleCreateTemplate"
                    minWidth="180"
                    style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;"/>
        </VBox>
    </StackPane>

    <!-- ========== Состояние "шаблон есть" ========== -->
    <VBox fx:id="templatePane" spacing="10" style="-fx-padding: 15px;" VBox.vgrow="ALWAYS">

        <!-- Верхняя панель: имя, описание, действия -->
        <HBox spacing="10" alignment="CENTER_LEFT">
            <VBox spacing="2" HBox.hgrow="ALWAYS">
                <Label fx:id="templateNameLabel" text=""
                       style="-fx-font-size: 16px; -fx-font-weight: bold;" wrapText="true"/>
                <Label fx:id="templateDescriptionLabel" text=""
                       style="-fx-font-size: 11px; -fx-text-fill: #666;" wrapText="true"/>
            </VBox>
            <Button fx:id="editTemplateButton" text="✏ Редактировать шаблон"
                    onAction="#handleEditTemplate" minWidth="180"/>
            <Button fx:id="refreshButton" text="🔄 Обновить"
                    onAction="#handleRefresh" minWidth="110"/>
        </HBox>

        <Separator/>

        <!-- Блок "Текущая версия" + кнопки редакторов -->
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Текущая версия:" style="-fx-font-weight: bold;"/>
            <Label fx:id="currentVersionLabel" text="—"
                   style="-fx-font-family: monospace;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="openFieldsEditorButton" text="📝 Редактор полей"
                    onAction="#handleOpenFieldsEditor" minWidth="160"/>
            <Button fx:id="openRuleEditorButton" text="⚙ Редактор правила"
                    onAction="#handleOpenRuleEditor" minWidth="160"/>
            <Button fx:id="previewButton" text="👁 Предпросмотр"
                    onAction="#handlePreview" minWidth="150"/>
        </HBox>

        <Separator/>

        <!-- Таблица версий -->
        <Label text="История версий:" style="-fx-font-weight: bold;"/>
        <TableView fx:id="versionsTable" VBox.vgrow="ALWAYS" prefHeight="280">
            <columns>
                <TableColumn fx:id="versionColumn" text="Версия" prefWidth="70"/>
                <TableColumn fx:id="statusColumn" text="Статус" prefWidth="110"/>
                <TableColumn fx:id="createdAtColumn" text="Создана" prefWidth="140"/>
                <TableColumn fx:id="publishedAtColumn" text="Опубликована" prefWidth="140"/>
                <TableColumn fx:id="createdByColumn" text="Автор" prefWidth="140"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>

        <!-- Lifecycle-кнопки — в две строки, чтобы всё помещалось -->
        <VBox spacing="5">
            <HBox spacing="8">
                <Button fx:id="createVersionButton" text="➕ Создать версию"
                        onAction="#handleCreateVersion" minWidth="170"/>
                <Button fx:id="cloneButton" text="📋 Клонировать"
                        onAction="#handleClone" minWidth="140"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="statusLabel" text="" style="-fx-text-fill: #666;"/>
            </HBox>
            <HBox spacing="8">
                <Button fx:id="publishButton" text="📢 Опубликовать"
                        onAction="#handlePublish" minWidth="150"/>
                <Button fx:id="deprecateButton" text="⬇ Деприкейт"
                        onAction="#handleDeprecate" minWidth="130"/>
                <Button fx:id="archiveButton" text="📦 Архивировать"
                        onAction="#handleArchive" minWidth="150"/>
                <Button fx:id="deleteVersionButton" text="🗑 Удалить"
                        onAction="#handleDeleteVersion" minWidth="120"/>
            </HBox>
        </VBox>
    </VBox>
</VBox>