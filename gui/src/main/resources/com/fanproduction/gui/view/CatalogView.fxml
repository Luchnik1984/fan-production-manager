<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.fanproduction.gui.controller.CatalogController">
    <padding>
        <Insets bottom="10" left="10" right="10" top="10" />
    </padding>

    <!-- Панель фильтров и поиска -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Тип продукции:" />
        <ComboBox fx:id="typeFilterComboBox" prefWidth="180" />
        <Label text="Поиск:" />
        <TextField fx:id="searchField" promptText="Наименование..." prefWidth="200" />
        <Button fx:id="searchButton" text="Найти" onAction="#handleSearch" />
        <Button fx:id="refreshButton" text="Обновить" onAction="#handleRefresh" />
        <Region HBox.hgrow="ALWAYS" />
        <Label fx:id="statusLabel" text="Всего: 0" />
    </HBox>

    <!-- Таблица карточек -->
    <TableView fx:id="productsTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="idColumn" text="ID" prefWidth="60" />
            <TableColumn fx:id="nameColumn" text="Наименование" prefWidth="250" />
            <TableColumn fx:id="codeColumn" text="Код" prefWidth="150" />
            <TableColumn fx:id="typeColumn" text="Тип" prefWidth="150" />
            <TableColumn fx:id="createdAtColumn" text="Дата создания" prefWidth="150" />
            <TableColumn fx:id="createdByColumn" text="Создал" prefWidth="150" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

    <!-- Панель действий и пагинации -->
    <HBox spacing="10" alignment="CENTER">
        <HBox spacing="10">
            <Button fx:id="createButton" text="➕ Создать" onAction="#handleCreate" />
            <Button fx:id="editButton" text="✏ Редактировать" onAction="#handleEdit" />
            <Button fx:id="deleteButton" text="🗑 Удалить" onAction="#handleDelete" />
        </HBox>
        <Region HBox.hgrow="ALWAYS" />
        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Button fx:id="prevButton" text="◀ Предыдущая" onAction="#handlePrevPage" disable="true" />
            <Label fx:id="pageLabel" text="Страница 1 из 1" />
            <Button fx:id="nextButton" text="Следующая ▶" onAction="#handleNextPage" disable="true" />
        </HBox>
    </HBox>
</VBox>