<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="15" style="-fx-background-color: #f4f4f4;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.fanproduction.gui.controller.RegisterController">
    <padding>
        <Insets bottom="30" left="30" right="30" top="30" />
    </padding>

    <!-- Заголовок -->
    <Label text="Регистрация нового пользователя">
        <font>
            <Font name="System Bold" size="18" />
        </font>
    </Label>

    <!-- Поле Email -->
    <VBox spacing="3" style="-fx-pref-width: 300px;">
        <Label text="Email:*" />
        <TextField fx:id="emailField" promptText="Введите email" />
    </VBox>

    <!-- Поле Пароль -->
    <VBox spacing="3" style="-fx-pref-width: 300px;">
        <Label text="Пароль:*" />
        <PasswordField fx:id="passwordField" promptText="Введите пароль" />
    </VBox>

    <!-- Поле Подтверждение пароля -->
    <VBox spacing="3" style="-fx-pref-width: 300px;">
        <Label text="Подтверждение пароля:*" />
        <PasswordField fx:id="confirmPasswordField" promptText="Повторите пароль" />
    </VBox>

    <!-- Поле Имя -->
    <VBox spacing="3" style="-fx-pref-width: 300px;">
        <Label text="Имя:" />
        <TextField fx:id="firstNameField" promptText="Введите имя" />
    </VBox>

    <!-- Поле Фамилия -->
    <VBox spacing="3" style="-fx-pref-width: 300px;">
        <Label text="Фамилия:" />
        <TextField fx:id="lastNameField" promptText="Введите фамилию" />
    </VBox>

    <!-- Поле Телефон -->
    <VBox spacing="3" style="-fx-pref-width: 300px;">
        <Label text="Телефон:" />
        <TextField fx:id="phoneField" promptText="Введите телефон" />
    </VBox>

    <!-- Поле Роль (только для ADMIN, будет скрыто для обычных пользователей) -->
    <VBox fx:id="roleBox" spacing="3" style="-fx-pref-width: 300px;" visible="false" managed="false">
        <Label text="Роль:" />
        <ComboBox fx:id="roleComboBox" prefWidth="300" />
    </VBox>

    <!-- Сообщение об ошибке -->
    <Label fx:id="errorLabel" textFill="red" wrapText="true" style="-fx-pref-width: 300px;" />

    <!-- Кнопки -->
    <HBox alignment="CENTER" spacing="10">
        <Button fx:id="registerButton" mnemonicParsing="false" onAction="#handleRegister" prefWidth="120" text="Зарегистрироваться" />
        <Button fx:id="backButton" mnemonicParsing="false" onAction="#handleBack" prefWidth="120" text="Назад" />
    </HBox>

    <Label text="* обязательные поля" style="-fx-font-size: 10px; -fx-text-fill: gray;" />
</VBox>
