<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="15" style="-fx-background-color: #f4f4f4;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.fanproduction.gui.controller.LoginController">
    <padding>
        <Insets bottom="40" left="40" right="40" top="40" />
    </padding>

    <!-- Заголовок -->
    <Label text="Fan Production Manager">
        <font>
            <Font name="System Bold" size="24" />
        </font>
    </Label>

    <Label text="Вход в систему">
        <font>
            <Font size="16" />
        </font>
    </Label>

    <!-- Поле Email -->
    <VBox spacing="5" style="-fx-pref-width: 300px;">
        <Label text="Email:" />
        <TextField fx:id="emailField" promptText="Введите email" />
    </VBox>

    <!-- Поле Пароль -->
    <VBox spacing="5" style="-fx-pref-width: 300px;">
        <Label text="Пароль:" />
        <PasswordField fx:id="passwordField" promptText="Введите пароль" />
    </VBox>

    <!-- Чекбокс "Запомнить меня" -->
    <HBox alignment="CENTER_LEFT" spacing="5" style="-fx-pref-width: 300px;">
        <CheckBox fx:id="rememberMeCheckBox" text="Запомнить меня" />
    </HBox>

    <!-- Сообщение об ошибке -->
    <Label fx:id="errorLabel" textFill="red" wrapText="true" style="-fx-pref-width: 300px;" />

    <!-- Кнопки -->
    <HBox alignment="CENTER" spacing="10">
        <Button fx:id="loginButton" mnemonicParsing="false" onAction="#handleLogin" prefWidth="120" text="Войти" />
        <Button fx:id="registerButton" mnemonicParsing="false" onAction="#handleRegister" prefWidth="120" text="Регистрация" />
    </HBox>

    <!-- Ссылка для восстановления пароля (опционально) -->
    <Hyperlink onAction="#handleForgotPassword" text="Забыли пароль?" visible="false" />
</VBox>
