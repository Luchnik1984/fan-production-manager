<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="15" alignment="TOP_CENTER" style="-fx-background-color: #f4f4f4;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.fanproduction.gui.controller.ProfileController">
    <padding>
        <Insets bottom="30" left="30" right="30" top="30" />
    </padding>

    <Label text="Мой профиль">
        <font>
            <Font name="System Bold" size="20" />
        </font>
    </Label>

    <Separator />

    <!-- Информация о пользователе (только для чтения) -->
    <GridPane hgap="10" vgap="10" style="-fx-pref-width: 400px;">
        <Label text="Email:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold;" />
        <Label fx:id="emailLabel" GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <Label text="Роль:" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: bold;" />
        <Label fx:id="roleLabel" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label text="Статус:" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-weight: bold;" />
        <Label fx:id="statusLabel" GridPane.columnIndex="1" GridPane.rowIndex="2" />

        <Label text="Дата регистрации:" GridPane.columnIndex="0" GridPane.rowIndex="3" style="-fx-font-weight: bold;" />
        <Label fx:id="createdAtLabel" GridPane.columnIndex="1" GridPane.rowIndex="3" />

        <Label text="Последний вход:" GridPane.columnIndex="0" GridPane.rowIndex="4" style="-fx-font-weight: bold;" />
        <Label fx:id="lastLoginLabel" GridPane.columnIndex="1" GridPane.rowIndex="4" />
    </GridPane>

    <Separator />

    <!-- Редактируемые поля -->
    <Label text="Редактирование профиля" style="-fx-font-weight: bold;" />

    <GridPane hgap="10" vgap="10" style="-fx-pref-width: 400px;">
        <Label text="Имя:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="firstNameField" GridPane.columnIndex="1" GridPane.rowIndex="0" promptText="Имя" />
        <Label fx:id="firstNameErrorLabel" GridPane.columnIndex="1" GridPane.rowIndex="1" textFill="red" style="-fx-font-size: 10px;" wrapText="true" />

        <Label text="Фамилия:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <TextField fx:id="lastNameField" GridPane.columnIndex="1" GridPane.rowIndex="2" promptText="Фамилия" />
        <Label fx:id="lastNameErrorLabel" GridPane.columnIndex="1" GridPane.rowIndex="3" textFill="red" style="-fx-font-size: 10px;" wrapText="true" />

        <Label text="Телефон:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
        <TextField fx:id="phoneField" GridPane.columnIndex="1" GridPane.rowIndex="4" promptText="+7 XXX XXX-XX-XX" />
        <Label fx:id="phoneErrorLabel" GridPane.columnIndex="1" GridPane.rowIndex="5" textFill="red" style="-fx-font-size: 10px;" wrapText="true" />
    </GridPane>

    <HBox spacing="10" alignment="CENTER">
        <Button fx:id="saveButton" text="Сохранить изменения" onAction="#handleSaveProfile" />
        <Button fx:id="changePasswordButton" text="Сменить пароль" onAction="#handleChangePassword" />
    </HBox>

    <Label fx:id="messageLabel" textFill="green" wrapText="true" style="-fx-pref-width: 400px;" />
</VBox>