<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.fanproduction.gui.controller.ProductMaterialsController">
    <padding>
        <Insets bottom="10" left="10" right="10" top="10" />
    </padding>

    <!-- Верхняя панель: выбор материала -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button fx:id="selectMaterialButton" text="Выбрать материал" onAction="#handleSelectMaterial" prefWidth="150" />
        <Label fx:id="selectedMaterialLabel" text="Не выбран" style="-fx-text-fill: #0066cc;" />
        <Region HBox.hgrow="ALWAYS" />
        <Label text="Кол-во:" />
        <TextField fx:id="quantityField" prefWidth="60" text="1.0" />
        <Button fx:id="addButton" text="➕ Добавить" onAction="#handleAddMaterial" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" />
        <Button fx:id="deleteButton" text="✖ Удалить" onAction="#handleDeleteSelected" style="-fx-background-color: #f44336; -fx-text-fill: white;" />
    </HBox>

    <!-- Таблица добавленных материалов -->
    <TableView fx:id="materialsTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="nameColumn" text="Наименование" prefWidth="180" />
            <TableColumn fx:id="classNameColumn" text="Класс" prefWidth="120" />
            <TableColumn fx:id="standardColumn" text="ГОСТ/ТУ" prefWidth="100" />
            <TableColumn fx:id="specificationColumn" text="Тех. параметры" prefWidth="120" />
            <TableColumn fx:id="materialTypeColumn" text="Тип" prefWidth="80" />
            <TableColumn fx:id="vendorCodeColumn" text="Артикул" prefWidth="100" />
            <TableColumn fx:id="quantityColumn" text="Кол-во" prefWidth="70" />
            <TableColumn fx:id="unitColumn" text="Ед. изм." prefWidth="55" minWidth="55" maxWidth="55" resizable="false" />
            <TableColumn fx:id="noteColumn" text="Примечание" prefWidth="150" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

    <Label fx:id="statusLabel" text="Готово" style="-fx-text-fill: #666;" />
</VBox>