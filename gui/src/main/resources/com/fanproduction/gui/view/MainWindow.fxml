<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="root" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.fanproduction.gui.controller.MainWindowController">
    <top>
        <MenuBar>
            <Menu text="Файл">
                <MenuItem text="Выйти" onAction="#handleExit" />
            </Menu>
            <Menu text="Справка">
                <MenuItem text="О программе" onAction="#handleAbout" />
            </Menu>
        </MenuBar>
    </top>
    <center>
        <TabPane>
            <Tab text="Главная" closable="false">
                <Label text="Добро пожаловать в Fan Production Manager!" />
            </Tab>
        </TabPane>
    </center>
    <bottom>
        <Label fx:id="statusLabel" text="Загрузка..." style="-fx-padding: 5; -fx-background-color: #f0f0f0;" />
    </bottom>
</BorderPane>